{
  "name": "harness_route",
  "description": "查询当前 flow 的路由状态（stage / gate / tier / cwd / worktree）。",
  "stage": "all",
  "handler": "./l1/handlers/harness_route.js",
  "input_schema": {
    "type": "object",
    "required": ["flowId"],
    "properties": {
      "flowId": {
        "type": "string",
        "pattern": "^[a-z0-9]([a-z0-9-]{0,62}[a-z0-9])?(\/[a-z0-9]([a-z0-9-]{0,62}[a-z0-9])?)*$"
      }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "ok": { "type": "boolean" },
      "route": {
        "type": "object",
        "properties": {
          "flowId": { "type": "string" },
          "stage": { "type": "string" },
          "gate": { "type": "object" },
          "tier": { "type": "string" },
          "cwd": { "type": "string" },
          "worktree": { "type": ["string","null"] }
        }
      },
      "error": { "type": "string" }
    }
  }
}
